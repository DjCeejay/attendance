# ==============================================================================
# ARTSCI Staff Attendance - Windows Office Server Production Environment
# Copy this file to .env on the Windows Office Computer and fill in credentials.
# ==============================================================================

APP_NAME="Staff Attendance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Office Server Fully Qualified Domain Name (Matches Caddyfile and DNS)
APP_URL=https://attendance.artsci.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database Configuration (Local PostgreSQL Service on Windows)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=artsci_attendance
DB_USERNAME=postgres
DB_PASSWORD=change_this_to_your_local_postgres_password
DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# Session & Cache (File-based or Database - No external Redis required)
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# Local Attendance LAN Verification Settings
# ------------------------------------------------------------------------------
# Modes:
# - 'local_lan': Strict LAN mode (Only devices on office Wi-Fi subnets can check in).
# - 'hybrid'   : Accepts both office LAN subnets and legacy public IP/DDNS.
# - 'public_ip': Legacy Railway public IP mode.
ATTENDANCE_VERIFICATION_MODE=local_lan

# Office Wi-Fi A (Tenda/ZTE) and Office Wi-Fi B (Airtel) Subnet CIDRs
OFFICE_LAN_SUBNETS="192.168.0.0/24,192.168.1.0/24,192.168.8.0/24"
ATTENDANCE_ALLOW_LOOPBACK=false

# ------------------------------------------------------------------------------
# Trusted Reverse Proxy Settings
# ------------------------------------------------------------------------------
# Since Caddy / IIS runs locally on the same Windows server, trust only loopback.
TRUSTED_PROXIES="127.0.0.1,::1"

# ------------------------------------------------------------------------------
# Security & PWA
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"
